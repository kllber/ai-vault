{
  "name": "ai-vault",
  "private": true,
  "version": "1.0.0",
  "description": "本地优先、端到端加密的 AI API 密钥管理工具",
  "author": "kllber",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:web": "tsc -b && vite build",
    "serve": "node cli/aivault.mjs serve",
    "preview": "vite preview",
    "app": "electron .",
    "app:build": "npm run build:web && electron-builder --win --dir"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.5.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "build": {
    "appId": "com.aivault.desktop",
    "productName": "AI Vault",
    "copyright": "Copyright © 2026 kllber",
    "asar": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "server/**/*",
      "!server/.data/**/*",
      "dist/**/*",
      "package.json",
      "!node_modules/**/*"
    ]
  }
}
